# Полный адрес подключения
# (драйвер/диалект, учётные данные, хост и порт, имя базы данных)
DATABASE_URL=

# Настройки FastAPI
DEBUG_SQLALCHEMY=   # Показывает SQL-запросы в консоль
APP_PORT=           # Порт сервера uvicorn

# Хеш
ADMIN_PASSWORD_HASH=your_hash_here

# Секретный ключ приложения
SECRET_KEY=